{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":configMigration",
    "helpers:pinGitHubActionDigests"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update Maven runner JAR versions in JBang aliases",
      "managerFilePatterns": [
        "/^jbang-catalog\\.json$/"
      ],
      "matchStrings": [
        "https://repo\\.maven\\.apache\\.org/maven2/io/github/jonesbusy/(?<artifact>[A-Za-z0-9._-]+)/(?<currentValue>[0-9][A-Za-z0-9._+-]*)/[^/\" ]+-runner\\.jar"
      ],
      "datasourceTemplate": "maven",
      "depNameTemplate": "io.github.jonesbusy.{{{artifact}}}"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "maven"
      ],
      "matchPackageNames": [
        "io.github.jonesbusy/**"
      ],
      "enabled": true
    }
  ]
}
